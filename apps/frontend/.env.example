# Copy to .env.local for development.
# Vercel: Project → Settings → Environment Variables.
#   Production: NEXT_PUBLIC_* → prod API / prod URL.
#   Preview: NEXT_PUBLIC_API_URL → https://api-staging.henzo.app (or HTTP until TLS on staging).
#   Enable deployments for branch "develop" in Git → if you want preview from develop.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production: https://henzo.app — Preview/staging: your preview URL or staging domain
NEXT_PUBLIC_FRONTEND_URL=https://henzo.app

# Production: https://api.henzo.app — Vercel Preview: https://api-staging.henzo.app (or http until TLS)
NEXT_PUBLIC_API_URL=https://api.henzo.app

NEXT_PUBLIC_TELEGRAM_LOGGER_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
