generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SessionBooking {
  id                     String        @id @default(cuid())
  studioId               String
  userId                 String
  trainingId             String
  trainerId              String?
  status                 BookingStatus @default(PENDING)
  notes                  String?
  /// Locale for client-facing booking emails (en, ru, vi)
  clientEmailLocale      String        @default("en")
  createdAt              DateTime      @default(now())
  startsAt               DateTime
  reminderSent           Boolean       @default(false)
  remindersSentIntervals Json?         @default("[]")
  Studio                 Studio        @relation(fields: [studioId], references: [id])
  Training               Training      @relation(fields: [trainingId], references: [id])
  Trainer                Trainer?      @relation(fields: [trainerId], references: [id])
  User                   User          @relation(fields: [userId], references: [id])
  Review                 Review[]

  @@index([studioId, status, startsAt])
  @@index([userId, startsAt])
  @@index([startsAt])
  @@index([studioId, createdAt])
  @@index([status, startsAt]) // P3: Для быстрого поиска по статусу и дате
  @@index([studioId, startsAt, status]) // P3: Составной индекс для фильтрации
  @@index([userId, status, startsAt]) // P2: Для быстрого поиска клиентских бронирований по статусу
}

model Review {
  id        String   @id @default(cuid())
  studioId  String
  userId    String
  bookingId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  Booking   SessionBooking? @relation(fields: [bookingId], references: [id])
  Studio    Studio    @relation(fields: [studioId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, studioId, bookingId])
  @@index([studioId, createdAt])
  @@index([studioId, rating])
}

enum StudioStatus {
  DRAFT
  READY
  ACTIVE
}

model Studio {
  id               String        @id @default(cuid())
  name             String
  description      String?
  address          String?
  phone            String?
  email            String?
  website          String?
  instagram        String?
  logoUrl          String?
  photos           String[]
  /// Gallery assets: original + per-format crops + cached hero/card URLs.
  photoGallery     Json?
  workingHours     Json?
  reminderSettings Json?         @default("{\"intervals\":[24]}")
  ownerId          String
  createdAt        DateTime      @default(now())
  latitude         Float? 
  longitude        Float?
  descriptionEn    String?
  descriptionVi    String?
  descriptionRu    String?
  timezone         String        @default("Asia/Ho_Chi_Minh") // IANA timezone identifier
  slug             String?       @unique // SEO-friendly slug for studio URLs
  status           StudioStatus   @default(DRAFT) // Studio publication status
  autoConfirmBookings Boolean   @default(false) // New bookings auto-confirmed (no owner approval)
  Booking          SessionBooking[]
  Review           Review[]
  User             User          @relation(fields: [ownerId], references: [id])
  Training         Training[]
  Trainer          Trainer[]
  Subscription     Subscription?
  TrainingSession  TrainingSession[]
  ClientBlocks     StudioClientBlock[]
  StudioClients    StudioClient[]
  TrainerInvites   TrainerInvite[]

  @@index([latitude, longitude])
  @@index([ownerId, createdAt])
  @@index([createdAt])
  @@index([slug]) // Index for fast slug lookups
}

model StudioClientBlock {
  id        String   @id @default(cuid())
  studioId  String
  userId    String?
  email     String?
  phone     String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  User      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@index([studioId, userId])
  @@index([studioId, email])
  @@index([studioId, phone])
  @@unique([studioId, userId])
}

model Training {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  duration           Int
  price              Float
  displayColor       String?
  studioId           String
  categoryId         String?
  trainingCategoryId Int?
  descriptionEn      String?
  descriptionVi      String?
  descriptionRu      String?
  language           String?
  Booking            SessionBooking[]
  Studio             Studio              @relation(fields: [studioId], references: [id])
  trainingCategory   TrainingCategory? @relation(fields: [trainingCategoryId], references: [id]) 
  Trainer            Trainer[]           @relation("TrainerTrainings")
  TrainingSession    TrainingSession[]

  @@unique([name, studioId])
  @@index([studioId])
}

model Trainer {
  id                                           String           @id @default(cuid())
  name                                         String
  accessLevel                                  TrainerAccessLevel @default(EMPLOYEE)
  email                                        String?
  phone                                        String?
  studioId                                     String
  userId                                       String?          @unique
  Booking                                      SessionBooking[]
  Studio                                       Studio           @relation(fields: [studioId], references: [id])
  Training                                     Training[]       @relation("TrainerTrainings")
  TrainingSession                              TrainingSession[]
  TrainerInvite                                TrainerInvite?
  User                                         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([name, studioId])
  @@index([studioId])
  @@index([userId])
}

model Subscription {
  id                String             @id @default(cuid())
  studioId          String             @unique
  type              SubscriptionType   @default(SOLO)
  status           SubscriptionStatus  @default(ACTIVE)
  startDate         DateTime
  /// End of the current paid period (from Stripe), when known.
  currentPeriodEnd  DateTime?
  manualOverride    Boolean            @default(false)
  manualOverrideAt  DateTime?
  manualOverrideBy  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  Studio            Studio             @relation(fields: [studioId], references: [id])
}

model TrainingSession {
  id          String              @id @default(cuid())
  studioId    String
  trainingId  String
  trainerId   String?
  locationId  String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int                 @default(1)
  bookedCount   Int                 @default(0)
  waitlistCount Int                 @default(0)
  status        TrainingSessionStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  Studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  Training      Training            @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  Trainer       Trainer?            @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  Enrollments   SessionEnrollment[]
  Waitlist      WaitlistEntry[]

  @@index([studioId, startsAt])
  @@index([studioId, status, startsAt])
  @@index([trainingId, startsAt])
  @@index([trainerId, startsAt])
}

model SessionEnrollment {
  id                String                  @id @default(cuid())
  sessionId         String
  userId            String
  status            SessionEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  cancelledAt       DateTime?
  TrainingSession   TrainingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, createdAt])
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  phone            String?
  avatarUrl        String?
  role             UserRole     @default(OWNER)
  /// Indicates that the user was created implicitly (e.g. via booking magic link)
  /// and has not yet completed full account registration.
  isGuest          Boolean      @default(false)
  createdAt        DateTime     @default(now())
  favoriteStudios  String[]     @default([])
  Booking          SessionBooking[]
  pushTokens       PushToken[]
  inAppNotifications InAppNotification[]
  Review           Review[]
  Studio           Studio[]
  SessionEnrollment   SessionEnrollment[]
  StudioClientBlocks  StudioClientBlock[]
  StudioClients       StudioClient[]
  WaitlistEntries     WaitlistEntry[]
  TrainerRecord       Trainer?
}

model StudioClient {
  id        String             @id @default(cuid())
  studioId  String
  userId    String
  source    StudioClientSource @default(MANUAL)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  Studio    Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  User      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
  @@index([studioId, createdAt])
}

model ClientRegistrationOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String
  language  String?  @default("en")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model TrainingCategory {
  id          Int    @id @default(autoincrement())
  name_en     String @unique
  name_vn     String @unique
  name_ru     String @unique
  chip_bg_hex String
  chip_fg_hex String?
  Training    Training[]
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
  PENDING
  NOSHOW
}

enum TrainerAccessLevel {
  ADMIN
  EMPLOYEE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum SubscriptionType {
  SOLO
  STUDIO
  ENTERPRISE
}

enum TrainingSessionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SessionEnrollmentStatus {
  ACTIVE
  NO_SHOW
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  CLIENT
}

enum StudioClientSource {
  MANUAL
  ENROLLMENT
}

model AdminEventLog {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("warn")
  message   String?
  metadata  Json?
  studioId  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

model AppFeedback {
  id         String    @id @default(cuid())
  name       String
  email      String
  message    String
  platform   String?
  appVersion String?
  status     String    @default("open")
  adminNote  String?
  resolvedAt DateTime?
  source     String    @default("mobile")
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

model TrainerInvite {
  id        String              @id @default(cuid())
  token     String              @unique
  studioId  String
  trainerId String              @unique
  status    TrainerInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime            @default(now())
  Studio    Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  Trainer   Trainer             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

enum TrainerInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  TrainingSession TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, createdAt])
}

model ScheduledPushReminder {
  id           String    @id @default(cuid())
  enrollmentId String
  userId       String
  sessionId    String
  type         String    // "24h" | "1h"
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([enrollmentId, type])
  @@index([scheduledFor, sentAt])
  @@index([enrollmentId])
}
