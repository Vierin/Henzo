generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SessionBooking {
  id                     String        @id @default(cuid())
  studioId               String
  userId                 String
  trainingId             String
  trainerId              String?
  status                 BookingStatus @default(PENDING)
  notes                  String?
  /// Locale for client-facing booking emails (en, ru, vi)
  clientEmailLocale      String        @default("en")
  createdAt              DateTime      @default(now())
  startsAt               DateTime
  reminderSent           Boolean       @default(false)
  remindersSentIntervals Json?         @default("[]")
  Studio                 Studio        @relation(fields: [studioId], references: [id])
  Training               Training      @relation(fields: [trainingId], references: [id])
  Trainer                Trainer?      @relation(fields: [trainerId], references: [id])
  User                   User          @relation(fields: [userId], references: [id])
  Review                 Review[]

  @@index([studioId, status, startsAt])
  @@index([userId, startsAt])
  @@index([startsAt])
  @@index([studioId, createdAt])
  @@index([status, startsAt]) // P3: Для быстрого поиска по статусу и дате
  @@index([studioId, startsAt, status]) // P3: Составной индекс для фильтрации
  @@index([userId, status, startsAt]) // P2: Для быстрого поиска клиентских бронирований по статусу
}

model PendingBooking {
  id          String   @id @default(cuid())
  token       String   @unique
  email       String
  bookingData Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([token])
}
 

model Review {
  id        String   @id @default(cuid())
  studioId  String
  userId    String
  bookingId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  Booking   SessionBooking? @relation(fields: [bookingId], references: [id])
  Studio    Studio    @relation(fields: [studioId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, studioId, bookingId])
  @@index([studioId, createdAt])
  @@index([studioId, rating])
}

enum StudioStatus {
  DRAFT
  READY
  ACTIVE
}

model Studio {
  id               String        @id @default(cuid())
  name             String
  description      String?
  address          String?
  phone            String?
  email            String?
  website          String?
  instagram        String?
  photos           String[]
  workingHours     Json?
  reminderSettings Json?         @default("{\"intervals\":[24]}")
  ownerId          String
  createdAt        DateTime      @default(now())
  latitude         Float? 
  longitude        Float?
  descriptionEn    String?
  descriptionVi    String?
  descriptionRu    String?
  timezone         String        @default("Asia/Ho_Chi_Minh") // IANA timezone identifier
  slug             String?       @unique // SEO-friendly slug for studio URLs
  status           StudioStatus   @default(DRAFT) // Studio publication status
  autoConfirmBookings Boolean   @default(false) // New bookings auto-confirmed (no owner approval)
  Booking          SessionBooking[]
  Review           Review[]
  User             User          @relation(fields: [ownerId], references: [id])
  Training         Training[]
  Trainer          Trainer[]
  Subscription     Subscription?
  TrainingSession  TrainingSession[]

  @@index([latitude, longitude])
  @@index([ownerId, createdAt])
  @@index([createdAt])
  @@index([slug]) // Index for fast slug lookups
}

model Training {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  duration           Int
  price              Float
  studioId           String
  categoryId         String?
  trainingCategoryId Int?
  nameEn             String?
  nameVi             String?
  nameRu             String?
  descriptionEn      String?
  descriptionVi      String?
  descriptionRu      String?
  Booking            SessionBooking[]
  Studio             Studio              @relation(fields: [studioId], references: [id])
  trainingCategory   TrainingCategory? @relation(fields: [trainingCategoryId], references: [id]) 
  Trainer            Trainer[]           @relation("TrainerTrainings")
  TrainingSession    TrainingSession[]

  @@unique([name, studioId])
  @@index([studioId])
}

model Trainer {
  id                                           String           @id @default(cuid())
  name                                         String
  accessLevel                                  TrainerAccessLevel @default(EMPLOYEE)
  email                                        String?
  phone                                        String?
  studioId                                     String
  Booking                                      SessionBooking[]
  Studio                                       Studio           @relation(fields: [studioId], references: [id])
  Training                                     Training[]       @relation("TrainerTrainings")
  TrainingSession                              TrainingSession[]

  @@unique([name, studioId])
  @@index([studioId])
}

model Subscription {
  id                String             @id @default(cuid())
  studioId          String             @unique
  type              SubscriptionType   @default(FREEMIUM)
  status           SubscriptionStatus  @default(ACTIVE)
  startDate         DateTime
  amount            Float
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  Studio            Studio             @relation(fields: [studioId], references: [id])
}

model TrainingSession {
  id          String              @id @default(cuid())
  studioId    String
  trainingId  String
  trainerId   String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int                 @default(1)
  bookedCount Int                 @default(0)
  status      TrainingSessionStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  Studio      Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  Training    Training            @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  Trainer     Trainer?            @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  Enrollments SessionEnrollment[]

  @@index([studioId, startsAt])
  @@index([trainingId, startsAt])
  @@index([trainerId, startsAt])
}

model SessionEnrollment {
  id                String                  @id @default(cuid())
  sessionId         String
  userId            String
  status            SessionEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  cancelledAt       DateTime?
  TrainingSession   TrainingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, createdAt])
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  phone            String?
  role             UserRole     @default(OWNER)
  /// Indicates that the user was created implicitly (e.g. via booking magic link)
  /// and has not yet completed full account registration.
  isGuest          Boolean      @default(false)
  createdAt        DateTime     @default(now())
  favoriteStudios  String[]     @default([])
  Booking          SessionBooking[]
  pushTokens       PushToken[]
  Review           Review[]
  Studio           Studio[]
  SessionEnrollment SessionEnrollment[]
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  language  String?  @default("en")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model TrainingCategory {
  id               Int       @id @default(autoincrement())
  name_en          String    @unique
  name_vn          String    @unique
  name_ru          String    @unique
  main_category_id Int?
  Training         Training[]
}

model RecommendedStudio {
  id         Int      @id @default(autoincrement())
  nameEn     String
  nameVi     String
  nameRu     String
  categoryId Int?
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([nameEn, nameVi, nameRu])
  @@index([priority])
  @@index([categoryId])
}

model City {
  id          String  @id
  name        String
  countryCode String  @default("VN")
  lat         Float
  lng         Float
  isActive    Boolean @default(true)

  @@index([countryCode, isActive])
  @@index([isActive])
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
  PENDING
  NOSHOW
}

enum TrainerAccessLevel {
  ADMIN
  EMPLOYEE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum SubscriptionType {
  FREEMIUM
  PRO
}

enum TrainingSessionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SessionEnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  CLIENT
}
