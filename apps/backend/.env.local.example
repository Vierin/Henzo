# Local development — copy to `.env.local` (never commit).
# Uses the STAGING Supabase project (separate from production).
#
#   cp .env.local.example .env.local   # macOS / Linux
#   copy .env.local.example .env.local # Windows
#
# HENZO_ENV=local is set automatically by `pnpm dev:backend`.

HENZO_ENV=local

# --- Staging Supabase (Dashboard → Settings → Database / API) ---
DATABASE_URL="postgresql://postgres.STAGING_REF:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.STAGING_REF:[PASSWORD]@aws-0-eu-central-1.compute-1.amazonaws.com:5432/postgres"

SUPABASE_URL="https://STAGING_REF.supabase.co"
SUPABASE_ANON_KEY="staging-anon-key"
SUPABASE_KEY="staging-anon-key"
SUPABASE_SERVICE_ROLE_KEY="staging-service-role-key"

JWT_SECRET="local-dev-jwt-min-32-chars-change-me"

# Brevo: use test/sandbox key or disable outbound email in dev
BREVO_API_KEY="xkeysib-staging-or-test"
EMAIL_FROM="dev@henzo.app"
EMAIL_FROM_NAME="Henzo Dev"

PORT=3001
NODE_ENV=development

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"

# Third-party: staging / test keys only
MAPBOX_ACCESS_TOKEN=""
STRIPE_SECRET_KEY="sk_test_..."
# Studio (web) — EUR Price IDs
STRIPE_STUDIO_PRICE_MONTHLY_ID="price_..."
# Enterprise (web) — EUR
STRIPE_ENTERPRISE_PRICE_MONTHLY_ID="price_..."
# Yearly billing is disabled. YEARLY_ID keys are ignored.
# Solo monthly Price in Stripe (EUR). Display fallback if unset: FALLBACK_SOLO_PRICE_MONTHLY_EUR
# STRIPE_SOLO_PRICE_MONTHLY_ID="price_..."
# Stripe CLI / Dashboard webhook signing secret for POST /webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional EUR fallbacks if Stripe prices unset (major units)
# FALLBACK_SOLO_PRICE_MONTHLY_EUR=7.99
# FALLBACK_STUDIO_PRICE_MONTHLY_EUR=22.99
# FALLBACK_ENTERPRISE_PRICE_MONTHLY_EUR=79.99
MOBILE_DEEP_LINK_SCHEME="henzo"

# RevenueCat (IAP sync + webhooks; entitlement IDs must match mobile)
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_STUDIO_ENTITLEMENT_ID=premium_studio
# REVENUECAT_ENTERPRISE_ENTITLEMENT_ID=premium_enterprise
# REVENUECAT_SOLO_ENTITLEMENT_ID=premium_solo
# REVENUECAT_WEBHOOK_AUTHORIZATION=<random-secret>

# Optional
# Comma-separated Google accounts allowed to use platform admin APIs.
# ADMIN_ALLOWED_EMAILS="admin@example.com"
# Re-authenticate admins after 12 hours (default: 43200).
# ADMIN_SESSION_MAX_AGE_SECONDS=43200
# SENTRY_DSN=
# GA4_MEASUREMENT_ID=
