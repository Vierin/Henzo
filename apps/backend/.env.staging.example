# DigitalOcean `backend_staging` — copy to `.env.staging` on the server (never commit).
# Same STAGING Supabase project as local `.env.local`.
#
# Deploy: docker compose env_file → .env.staging (see deploy/DEPLOY.md)

HENZO_ENV=staging

# --- Staging Supabase ---
DATABASE_URL="postgresql://postgres.STAGING_REF:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.STAGING_REF:[PASSWORD]@aws-0-eu-central-1.compute-1.amazonaws.com:5432/postgres"

SUPABASE_URL="https://STAGING_REF.supabase.co"
SUPABASE_ANON_KEY="staging-anon-key"
SUPABASE_KEY="staging-anon-key"
SUPABASE_SERVICE_ROLE_KEY="staging-service-role-key"

JWT_SECRET="staging-jwt-secret-min-32-chars"

BREVO_API_KEY="xkeysib-staging"
EMAIL_FROM="staging@henzo.app"
EMAIL_FROM_NAME="Henzo Staging"

PORT=3002
NODE_ENV=production

FRONTEND_URL="https://staging.henzo.app"
BACKEND_URL="https://api-staging.henzo.app"

MAPBOX_ACCESS_TOKEN=""
STRIPE_SECRET_KEY="sk_test_..."
MOBILE_DEEP_LINK_SCHEME="henzo"

# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_STUDIO_ENTITLEMENT_ID=premium_studio
# REVENUECAT_ENTERPRISE_ENTITLEMENT_ID=premium_enterprise
# REVENUECAT_WEBHOOK_AUTHORIZATION=<random-secret>
