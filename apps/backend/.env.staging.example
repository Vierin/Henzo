# Copy to .env.staging on the server (never commit .env.staging).
# Use Neon "Create branch" connection string for staging DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Mirror other secrets from .env.production where the app requires them
# (JWT, OAuth, Mapbox, etc.). Prefer separate test keys for third-party APIs.

PORT=3002
NODE_ENV=production
