# Firebase and other plugins require iOS 15+ — keep in sync with Runner deployment target
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Pods с известными некритичными варнингами (deprecated API, implicit cast и т.п.)
  NOISY_PODS = %w[
    device_info_plus FPPDeviceInfoPlusPlugin
    firebase_messaging FLTFirebaseMessagingPlugin
    flutter_image_compress_common CompressFileHandler SYMetadata
    geolocator_apple LocationServiceStreamHandler PermissionHandler
    health SwiftHealthPlugin
    image_picker_ios FLTImagePickerImageUtil FLTImagePickerPlugin
    flutter_local_notifications FlutterLocalNotificationsPlugin
    permission_handler_apple PhonePermissionStrategy
    purchases_flutter PurchasesFlutterPlugin
    share_plus FPPSharePlusPlugin
    AppAuth OIDExternalUserAgentIOS OIDExternalUserAgentIOSCustomBrowser
    FirebaseCrashlytics
  ].freeze

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Xcode 26+ ругается на pods с таргетом < 12
      t = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0' if t.nil? || t.to_f < 15.0

      if NOISY_PODS.include?(target.name)
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS']       = 'YES'
      end
    end
  end

  # Crashlytics: добавить Run Script Phase в Runner для upload dSYMs.
  # Идемпотентно: если фаза уже есть — не дублируем.
  runner_project = Xcodeproj::Project.open(File.expand_path('Runner.xcodeproj', __dir__))
  runner_project.targets.each do |target|
    next unless target.name == 'Runner'

    phase_name = '[firebase_crashlytics] Crashlytics Upload Symbols'
    next if target.shell_script_build_phases.any? { |p| p.name == phase_name }

    phase = target.new_shell_script_build_phase(phase_name)
    # Skip upload in Debug (JIT builds have empty dSYMs — nothing to upload).
    phase.shell_script = <<~SH
      if [ "${CONFIGURATION}" = "Debug" ]; then
        echo "Crashlytics: skipping dSYM upload in Debug build."
        exit 0
      fi
      "${PODS_ROOT}/FirebaseCrashlytics/run"
    SH
    phase.input_paths = [
      '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${TARGET_NAME}',
      '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}',
      '$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist',
      '$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)',
    ]
  end
  runner_project.save
end
