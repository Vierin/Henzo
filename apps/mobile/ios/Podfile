# Firebase and other plugins require iOS 15+ — keep in sync with Runner deployment target
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Pods с известными некритичными варнингами (deprecated API, implicit cast и т.п.)
  NOISY_PODS = %w[
    device_info_plus FPPDeviceInfoPlusPlugin
    firebase_messaging FLTFirebaseMessagingPlugin
    flutter_image_compress_common CompressFileHandler SYMetadata
    geolocator_apple LocationServiceStreamHandler PermissionHandler
    health SwiftHealthPlugin
    image_picker_ios FLTImagePickerImageUtil FLTImagePickerPlugin
    flutter_local_notifications FlutterLocalNotificationsPlugin
    permission_handler_apple PhonePermissionStrategy
    purchases_flutter PurchasesFlutterPlugin
    share_plus FPPSharePlusPlugin
    AppAuth OIDExternalUserAgentIOS OIDExternalUserAgentIOSCustomBrowser
    FirebaseCrashlytics
  ].freeze

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Xcode 26+ ругается на pods с таргетом < 12
      t = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0' if t.nil? || t.to_f < 15.0
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      config.build_settings['COPY_PHASE_STRIP'] = 'NO'
      config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      # arm64 simulator exclusion removed — Xcode 26+ requires arm64 for Apple Silicon simulators.
      # App Store "iossimulator platform" issue is handled by "Strip Simulator Platform Flags v4" script.

      if NOISY_PODS.include?(target.name)
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS']       = 'YES'
      end
    end
  end

  # Crashlytics: добавить Run Script Phase в Runner для upload dSYMs.
  # Идемпотентно: если фаза уже есть — не дублируем.
  runner_project = Xcodeproj::Project.open(File.expand_path(File.join(File.dirname(__FILE__), 'Runner.xcodeproj')))
  runner_project.targets.each do |target|
    next unless target.name == 'Runner'

    # Fix "unsupported platform in arm64 slice" App Store validation error.
    # Always remove and re-add so the phase stays AFTER "Embed Pods Frameworks"
    # and picks up the latest script on every pod install.
    target.shell_script_build_phases.select { |p|
      ['Strip Simulator Platform Flags',
       'Strip Simulator Platform Flags v2',
       'Strip Simulator Platform Flags v3',
       'Strip Simulator Platform Flags v4'].include?(p.name)
    }.each(&:remove_from_project)

    strip_phase = target.new_shell_script_build_phase('Strip Simulator Platform Flags v4')
    strip_phase.shell_script = <<~'SH'
      if [ "${CONFIGURATION}" = "Debug" ]; then exit 0; fi
      FRAMEWORKS="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}"
      [ -d "${FRAMEWORKS}" ] || exit 0

      fix_binary() {
        local binary="$1"
        # Check if any arch slice contains IOSSIMULATOR platform tag
        build_info=$(xcrun vtool -show-build "${binary}" 2>/dev/null) || return 0
        echo "${build_info}" | grep -qiE "IOSSIMULATOR" || return 0
        echo "[strip] Fixing simulator platform flags: $(basename "${binary}")"
        local tmp1 tmp2
        tmp1=$(mktemp)
        tmp2=$(mktemp)
        # Use -arch arm64 to target only the device slice in fat/universal binaries
        if xcrun vtool -arch arm64 -remove-build-version iossimulator \
            -output "${tmp1}" "${binary}" 2>/dev/null; then
          if xcrun vtool -arch arm64 -set-build-version ios \
              "${IPHONEOS_DEPLOYMENT_TARGET}" "${IPHONEOS_DEPLOYMENT_TARGET}" \
              -output "${tmp2}" "${tmp1}" 2>/dev/null || \
             xcrun vtool -arch arm64 -set-build-version ios \
              "${IPHONEOS_DEPLOYMENT_TARGET}" "${IPHONEOS_DEPLOYMENT_TARGET}" \
              -replace -output "${tmp2}" "${tmp1}" 2>/dev/null; then
            mv "${tmp2}" "${binary}"
            echo "[strip] Done: $(basename "${binary}")"
          fi
        fi
        rm -f "${tmp1}" "${tmp2}"
      }

      # Fix .framework binaries (error 409)
      find "${FRAMEWORKS}" -name "*.framework" -type d | while IFS= read -r fw; do
        binary="${fw}/$(basename "${fw}" .framework)"
        [ -f "${binary}" ] && fix_binary "${binary}"
      done

      # Fix loose .dylib files
      find "${FRAMEWORKS}" -name "*.dylib" -type f | while IFS= read -r dylib; do
        fix_binary "${dylib}"
      done

      # Sync MinimumOSVersion in framework Info.plist (error 90208)
      find "${FRAMEWORKS}" -name "Info.plist" | while IFS= read -r plist; do
        current=$(/usr/libexec/PlistBuddy -c "Print :MinimumOSVersion" "${plist}" 2>/dev/null)
        [ -z "${current}" ] && continue
        if [ "${current}" != "${IPHONEOS_DEPLOYMENT_TARGET}" ]; then
          echo "[strip] Updating MinimumOSVersion: $(dirname "${plist}" | xargs basename)"
          /usr/libexec/PlistBuddy -c "Set :MinimumOSVersion ${IPHONEOS_DEPLOYMENT_TARGET}" "${plist}" 2>/dev/null || true
        fi
      done
    SH

    dsym_phase_name = 'Generate Missing Framework dSYMs'
    unless target.shell_script_build_phases.any? { |p| p.name == dsym_phase_name }
      dsym_phase = target.new_shell_script_build_phase(dsym_phase_name)
      dsym_phase.shell_script = <<~SH
        if [ "${CONFIGURATION}" = "Debug" ]; then exit 0; fi
        find "${DWARF_DSYM_FOLDER_PATH}" -maxdepth 0 2>/dev/null || mkdir -p "${DWARF_DSYM_FOLDER_PATH}"
        find "${TARGET_BUILD_DIR}" -name "*.framework" -type d | while read fw; do
          name=$(basename "$fw" .framework)
          dsym="${DWARF_DSYM_FOLDER_PATH}/${name}.framework.dSYM"
          if [ ! -d "$dsym" ]; then
            echo "Generating dSYM for ${name}.framework"
            dsymutil "${fw}/${name}" -o "$dsym" 2>/dev/null || true
          fi
        done
      SH
    end

    phase_name = '[firebase_crashlytics] Crashlytics Upload Symbols'
    next if target.shell_script_build_phases.any? { |p| p.name == phase_name }

    phase = target.new_shell_script_build_phase(phase_name)
    # Skip upload in Debug (JIT builds have empty dSYMs — nothing to upload).
    phase.shell_script = <<~SH
      if [ "${CONFIGURATION}" = "Debug" ]; then
        echo "Crashlytics: skipping dSYM upload in Debug build."
        exit 0
      fi
      "${PODS_ROOT}/FirebaseCrashlytics/run"
    SH
    phase.input_paths = [
      '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${TARGET_NAME}',
      '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}',
      '$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist',
      '$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)',
    ]
  end
  runner_project.save
end
