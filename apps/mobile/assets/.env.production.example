# Production / store builds — copy to `apps/mobile/assets/.env`
# Debug builds use `assets/.env.local` instead (see `.env.local.example`).

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_HENZO_ENV=production

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROD_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=prod-anon-key

EXPO_PUBLIC_API_URL=https://api.henzo.app
EXPO_PUBLIC_WEB_URL=https://henzo.app

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_STUDIO_PHOTOS_BUCKET=studio-photos

EXPO_PUBLIC_REVENUECAT_API_KEY=appl_or_goog_prod_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
