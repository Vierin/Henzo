# Local development — copy to `apps/mobile/assets/.env`
# (Flutter bundles assets/.env; keep prod keys out of this file.)

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_HENZO_ENV=local

# Staging Supabase (same project as backend `.env.local`)
EXPO_PUBLIC_SUPABASE_URL=https://STAGING_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key

# Local backend
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:3000

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_STUDIO_PHOTOS_BUCKET=studio-photos

# RevenueCat Test Store only for local
EXPO_PUBLIC_REVENUECAT_API_KEY=test_xxx
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
