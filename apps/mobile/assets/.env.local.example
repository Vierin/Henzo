# Example env for local dev and widget tests (no secrets).
# Copy to assets/.env or assets/.env.local and fill real values:
#   cp assets/.env.local.example assets/.env.local

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_HENZO_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# Android emulator → host machine backend (npm run dev in apps/backend)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# Physical device: use your LAN IP, e.g. http://192.168.1.10:3001
# Production: https://api.henzo.app
EXPO_PUBLIC_WEB_URL=https://www.henzo.app

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_STUDIO_PHOTOS_BUCKET=studio-photos

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_STUDIO_ENTITLEMENT_ID=premium_studio
EXPO_PUBLIC_REVENUECAT_ENTERPRISE_ENTITLEMENT_ID=premium_enterprise
