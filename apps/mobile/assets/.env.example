# development | dev = dev-логи и т.п.; production (или пусто) = prod
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=https://api.henzo.app
# Google Sign-In (тот же Web Client ID, что в Supabase → Auth → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Только для iOS (опционально)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Bucket для фотографий студии в Supabase Storage
EXPO_PUBLIC_STUDIO_PHOTOS_BUCKET=studio-photos
