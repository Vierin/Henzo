{
  "name": "henzo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:clean": "turbo run dev --force",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:health": "node ./scripts/dev-health-check.mjs",
    "lint": "turbo run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint:backend:check": "pnpm --filter backend run lint:check",
    "format:backend": "pnpm --filter backend run format",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
