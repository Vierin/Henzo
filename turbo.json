{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "SUPABASE_URL",
    "SUPABASE_KEY",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "JWT_SECRET",
    "BREVO_API_KEY",
    "EMAIL_FROM",
    "EMAIL_FROM_NAME",
    "PORT",
    "NODE_ENV",
    "HENZO_ENV",
    "HENZO_LOG_ENV",
    "BACKEND_URL",
    "FRONTEND_URL",
    "MAPBOX_ACCESS_TOKEN",
    "HENZO_NEXT_DIST_DIR",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_FRONTEND_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.staging",
        ".env.production",
        ".env.development",
        ".env.development.local"
      ]
    }
  }
}
